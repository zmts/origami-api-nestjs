<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Test email</title>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,200..800;1,200..800&display=swap" rel="stylesheet"/>
</head>
<body style="margin: 0; padding: 0 16px; background-color: #f0f2f5; font-family: 'Plus Jakarta Sans', Arial, sans-serif;">
<div style="width: 100%; max-width: 784px; margin: 0 auto;">
  <br/>
  <div style="text-align: center; margin-bottom: 20px; margin-top: 30px">
    <img src="https://www.google.com/images/branding/googlelogo/2x/googlelogo_color_272x92dp.png" style="width: 202px;">
  </div>
  <div style="margin: 0 auto; background-color: #ffffff; border-radius: 8px; overflow: hidden; box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);">
    <div style="padding: 64px;">
      <p style="color: #6E6DA9; margin: 0; line-height: 24px;">Hello user: {{ username }}</p>
      <p style="color: #6E6DA9; margin: 0; line-height: 24px;">U have content: {{ content }}</p>
    </div>
  </div>
</div>
</body>
</html>
